# Visual Cataloguer - Environment Configuration
# Copy this to .env and fill in your values

# Port (default: 8000)
PORT=8000

# AI Provider keys (optional — at least one needed for AI identification)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama runs locally — no key needed, just make sure it's accessible
# OLLAMA_HOST=http://host.docker.internal:11434
