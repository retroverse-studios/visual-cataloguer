# Visual Cataloguer - Environment Configuration
# Copy this to .env and uncomment/fill in what you need.
# An empty .env file works — everything has sensible defaults.

# ── Server ──
# PORT=8000

# ── Claude (Anthropic) ──
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Ollama (local, no key needed) ──
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llava
